{
  "name": "stackwise-technologies-limited",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "next dev",
    "build": "node scripts/next-production-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:worker": "OPENNEXT_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "preview": "OPENNEXT_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "OPENNEXT_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:live": "bash scripts/deploy-live.sh",
    "cf:secrets": "node scripts/sync-cloudflare-env.mjs .env.prod",
    "db:migrate:prod": "MIGRATE_ENV=prod node scripts/migrate.mjs",
    "db:reset:prod-payments": "MIGRATE_ENV=prod node scripts/db-reset-prod-payments.mjs",
    "cf:whoami": "wrangler whoami",
    "cf:status": "wrangler deployments status --name stackwise-technologies",
    "growth:push": "node scripts/growth-connector.mjs push",
    "growth:cookies:upload": "node scripts/growth-connector.mjs upload-cookies",
    "growth:cookies:pull": "node scripts/growth-connector.mjs pull-cookies",
    "growth:connect": "node scripts/growth-connect.mjs",
    "growth:harvest": "node scripts/growth-harvest.mjs",
    "growth:connect-server": "node scripts/growth-connect-server.mjs",
    "integrations:secret": "node scripts/generate-ingest-secret.mjs",
    "integrations:up": "node scripts/integrations-up.mjs",
    "integrations:down": "node scripts/integrations-down.mjs",
    "integrations:check": "node scripts/integrations-local-check.mjs",
    "integrations:smoke": "node scripts/huginn-ingest-smoke.mjs",
    "integrations:freehire:sample": "node scripts/freehire-ingest.mjs deploy/integrations/freehire/sample-jobs.json",
    "integrations:freehire:clone": "node scripts/freehire-clone.mjs",
    "integrations:freehire:up": "node scripts/integrations-freehire-up.mjs",
    "integrations:freehire:down": "node scripts/integrations-freehire-down.mjs",
    "integrations:freehire:restart": "node scripts/integrations-freehire-restart.mjs",
    "integrations:freehire:status": "node scripts/integrations-freehire-status.mjs",
    "integrations:freehire:ui": "node scripts/integrations-freehire-ui-dev.mjs",
    "integrations:freehire:crawl": "node scripts/integrations-freehire-crawl.mjs",
    "integrations:freehire:export": "node scripts/freehire-export-stackwise.mjs",
    "integrations:jobs:demo": "node scripts/integrations-jobs-demo.mjs",
    "integrations:huginn:up": "node scripts/integrations-up.mjs",
    "integrations:huginn:down": "node scripts/integrations-down.mjs",
    "integrations:huginn:scenario": "node scripts/render-huginn-scenario.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@neondatabase/serverless": "^1.0.2",
    "next": "16.2.6",
    "nodemailer": "^7.0.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.49.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.114.0"
  }
}
