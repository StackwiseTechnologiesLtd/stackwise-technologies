{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stackwise-technologies",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "browser": {
    "binding": "BROWSER",
  },
  // Secrets live in Cloudflare only — never commit keys here.
  // Deploy: node scripts/sync-cloudflare-env.mjs .env.prod
  "vars": {},
}
