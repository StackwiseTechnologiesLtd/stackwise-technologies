# Optional env for docker compose (copy values from repo root .env.local).
# Compose also reads ../../.env.local when present (required: false).

# Shared with Stackwise app — required for job-ingest profile and host scripts
# INTEGRATIONS_INGEST_SECRET=

# Huginn Rails secret (local dev default in compose if unset)
# HUGINN_APP_SECRET_TOKEN=

# Target for adapters inside Docker (Stackwise on host)
INGEST_URL=http://host.docker.internal:3000/api/admin/integrations/ingest
