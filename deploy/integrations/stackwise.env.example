# Local integration env (copy to .env.local on the Stackwise app machine)

# Required — same value on Cloudflare when you deploy
# INTEGRATIONS_INGEST_SECRET=

# Where Huginn / freehire POST (local dev)
INGEST_URL=http://localhost:3000/api/admin/integrations/ingest

# Production target (VPS adapters only — do not use on laptop unless testing prod)
# INGEST_URL=https://stackwisetechnologies.com/api/admin/integrations/ingest

# Optional second bearer accepted by ingest
# HUGINN_WEBHOOK_TOKEN=
